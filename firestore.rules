rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Chat/reaksi = perantara sementara: dokumen valid, lalu dihapus pengirim (atau siapa pun anggota setelah 60 detik)
    function validChat() {
      return request.resource.data.keys().hasOnly(['uid', 'name', 'kind', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['text', 'react', 'sticker']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.at == request.time;
    }
    function staleChat() { return request.time > resource.data.at + duration.value(60, 's'); }

    // ---- Profil publik ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 40;
      allow update: if isSelf(uid) && request.resource.data.uid == uid && request.resource.data.handle == resource.data.handle;
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        // Pemilik boleh menulis jika ada permintaan dari/ke dirinya; penerima boleh menulis sisi lainnya
        allow create: if (isSelf(uid) && exists(/databases/$(database)/documents/friendRequests/$(friendUid + '_' + uid)))
                      || (isSelf(friendUid) && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid)));
        allow delete: if isSelf(uid) || isSelf(friendUid);
        allow update: if false;
      }
      match /history/{id} {
        allow read, create: if isSelf(uid);
        allow update, delete: if false;
      }
    }
    match /handles/{h} {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/handles/$(h)) && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Permintaan pertemanan: id = pengirim_penerima (mencegah ganda) ----
    match /friendRequests/{id} {
      // get pada dokumen yang belum ada harus diizinkan (resource == null), kalau tidak pemeriksaan "sudah terkirim?" gagal
      allow get: if signedIn() && (resource == null || resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ---- Grup ----
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid] && request.resource.data.max <= 12;
      // Pemilik: kelola anggota/kode. Pengguna lain: hanya menambahkan dirinya sendiri (maks. kapasitas).
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.ownerUid && request.resource.data.ownerUid == resource.data.ownerUid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= resource.data.max)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.auth.uid in resource.data.members && !(request.auth.uid in request.resource.data.members)));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
      match /chat/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        allow create: if signedIn() && validChat() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members && (resource.data.uid == request.auth.uid || staleChat());
      }
    }
    // Kode grup hanya bisa di-get (tidak bisa di-list) sehingga tidak dapat ditebak massal
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }
    match /groupInvites/{id} {
      allow get: if signedIn() && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && id == request.resource.data.groupId + '_' + request.resource.data.to
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if false;
    }

    // ---- Ruang permainan ----
    match /rooms/{code} {
      // get terbuka untuk pengguna masuk (perlu untuk bergabung via kode); list tidak diizinkan
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid && request.resource.data.status == 'lobby'
        && request.resource.data.players.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn() && (
        // host mengatur status/ronde
        (request.auth.uid == resource.data.hostUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'round', 'starts']))
        // pemain bergabung / keluar: hanya mengubah entri dirinya sendiri
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
            && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
            && resource.data.status == 'lobby' && request.resource.data.players.size() <= 8));
      // Host membersihkan ruang setelah selesai (subkoleksi dihapus lebih dulu oleh klien)
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid && resource.data.status == 'finished';

      // Jawaban: create-only, id = ronde_uid, hanya saat ruang 'playing'. Game papan boleh memakai nomor langkah sebagai ronde.
      match /answers/{aid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && aid == string(request.resource.data.round) + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'round', 'choice', 'at', 'text'])
          && request.resource.data.choice is int && request.resource.data.round is int
          && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 140))
          && request.resource.data.at == request.time
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'playing'
          && (get(/databases/$(database)/documents/rooms/$(code)).data.gameId in ['tictactoe', 'connect4', 'uno', 'gaple', 'ulartangga']
              || get(/databases/$(database)/documents/rooms/$(code)).data.round == request.resource.data.round)
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow update: if false;
        allow delete: if signedIn() && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
      }
      // Skor akhir pemain pada game adu-skor (create-only, satu per pemain)
      match /scores/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow create: if isSelf(uid) && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'score', 'at']) && request.resource.data.score is int
          && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
          && request.resource.data.at == request.time
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'playing'
          && uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow update, delete: if false;
      }
      // Chat & reaksi ruang (sementara)
      match /chat/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow create: if signedIn() && validChat() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys();
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players.keys() && (resource.data.uid == request.auth.uid || staleChat());
      }
    }

    // ---- Antrean pencarian lawan acak (doc id = uid) ----
    match /matchQueue/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && request.resource.data.uid == uid && request.resource.data.status == 'waiting';
      // pemilik mengubah dirinya; pencari lain hanya boleh menandai "matched" + kode ruang pada entri yang masih menunggu
      allow update: if isSelf(uid) || (signedIn() && resource.data.status == 'waiting' && request.resource.data.status == 'matched'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'roomCode']));
      allow delete: if isSelf(uid);
    }
    // ---- Presensi: hanya teman yang boleh melihat (get per teman), tidak bisa di-list ----
    match /presence/{uid} {
      allow get: if signedIn() && (isSelf(uid) || exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)));
      allow list: if false;
      allow create, update: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if isSelf(uid);
    }
    // ---- Undangan bermain: id = pengirim_penerima; pengirim harus host ruang tersebut ----
    match /roomInvites/{id} {
      allow get: if signedIn() && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow list: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.to != request.auth.uid
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.code)).data.hostUid == request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // ---- Chat langsung antarteman (sementara). Id = dua uid terurut digabung "_" ----
    match /dmChats/{pair}/msgs/{mid} {
      allow read: if signedIn() && request.auth.uid in pair.split('_');
      allow create: if signedIn() && validChat() && request.auth.uid in pair.split('_')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(pair.replace(request.auth.uid, '').replace('_', '')));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in pair.split('_') && (resource.data.uid == request.auth.uid || staleChat());
    }
  }
}
