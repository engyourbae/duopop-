# Salin menjadi .env.local lalu isi dari Firebase Console > Project settings > Your apps > Web app.
# Nilai ini BUKAN rahasia (dilindungi Security Rules), tetapi jangan pernah menaruh service account di sini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opsional: subpath GitHub Pages, mis. /duopop/ (default ./ sudah aman)
# VITE_BASE=/duopop/
